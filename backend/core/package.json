{
  "name": "catalystjs",
  "version": "1.4.0",
  "description": "",
  "author": "ibm-consulting",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "core",
    "core-modules/**",
    "src/core-staging/**",
    "src/apps/**"
  ],
  "scripts": {
    "build": "yarn run generate:tsconfig && nest build",
    "build:docker": "nest build -p tsconfig.build.docker.json",
    "docker:build": "node core/scripts/docker-build.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\" \"packages/**/*.ts\"",
    "generate:tsconfig": "node core/scripts/generate-tsconfig.js",
    "generate:nest-cli": "node core/scripts/generate-nest-cli.js",
    "generate:docs": "node core/scripts/generate-docs.js",
    "generate:feature:index": "node core/scripts/generate-feature-index.js",
    "generate:plugin:index": "node core/scripts/generate-plugin-index.js",
    "install:core": "node core/scripts/install-core.js",
    "install:plugin": "node core/scripts/install-plugin.js",
    "install:feature": "node core/scripts/install-feature.js",
    "install:database": "node core/scripts/install-database.js",
    "start": "node core/scripts/start.js",
    "start:dev": "nest start --watch --entryFile main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:wiki": "cd docs && bundle install && bundle exec jekyll serve",
    "lint": "eslint \"{src,packages}/**/*.ts\" --fix",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage --config vitest.config.mts",
    "test:debug": "node --inspect-brk ./node_modules/.bin/vitest run --config vitest.config.mts",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky",
    "postinstall": "node scripts/patch-nestjs-fastify-reply.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "axios": "1.19.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "graphql": "^16.14.2",
    "graphql-kafkajs-subscriptions": "^4.0.11",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-scalars": "^1.26.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^6.2.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "moment": "^2.30.1",
    "openai": "^7.4.0",
    "openapi-typescript": "7.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "strip-ansi": "6.0.1",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "quicktype-core": "^26.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  }
}
