HOST=0.0.0.0
PORT=3100
ADMIN_PORT=4001
GRAPHQL_DEBUG=true
DISABLE_GRAPHQL_PLAYGROUND=false
DISABLE_OPENAPI_SWAGGER=false
NODE_TLS_REJECT_UNAUTHORIZED=0
DISABLE_ADMIN_APP=false
ACCESS_LOGGING=true
SERVICE_LOGGING={"*":true}
REGISTRY_CONFIG={}
MAPPER_LOGGING={"*":false}
API_ACCESS_CONTROL_ENABLED=false

# --- Shopify (trial store) ---------------------------------------------------
# Ask your trainer for the Storefront access token. host MUST include https://
# One line, JSON string. Used by requests sent with header `x-consumer: shopify-app`.
DATASOURCE_CONFIG_SHOPIFY={"host":"https://REPLACE-STORE.myshopify.com","graphqlPath":"/api/:version/graphql.json","apiKey":"REPLACE_WITH_TOKEN_FROM_TRAINER"}
